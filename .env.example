# Sentinel Assess environment. Copy to .env and replace every placeholder.
# Never commit real values.

NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL. The migrator role owns tables; the app role is subject to RLS.
DATABASE_URL=postgres://sentinel_app:change-me-app@localhost:5432/sentinel
MIGRATION_DATABASE_URL=postgres://sentinel_owner:change-me-owner@localhost:5432/sentinel
POSTGRES_PASSWORD=change-me-superuser
SENTINEL_OWNER_PASSWORD=change-me-owner
SENTINEL_APP_PASSWORD=change-me-app

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Absolute session lifetime: refresh stops working this long after sign-in (30 days).
SESSION_ABSOLUTE_TTL_SECONDS=2592000

# Embedding: comma-separated origins of host pages allowed to call the API (CORS) and to frame
# the PWA. Bare origins only (scheme://host[:port]); https in production. Empty means none.
EMBED_ORIGINS=

# Per-user rate limits on data routes (requests per window), sync, and photo analysis.
DATA_RATE_LIMIT_MAX=600
DATA_RATE_LIMIT_WINDOW_SECONDS=60
SYNC_RATE_LIMIT_MAX=120
AI_ANALYZE_RATE_LIMIT_PER_HOUR=30

# Public base URL of this API (used for local-driver signed photo URLs).
API_PUBLIC_URL=http://localhost:3000

# Photo storage. STORAGE_DRIVER=local keeps files under LOCAL_STORAGE_DIR and serves them through
# HMAC-signed, expiring /files/<token> URLs; s3 uses presigned GETs (MinIO locally).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
# Optional separate signing key for local URLs (at least 32 chars); unset derives one from JWT_SECRET.
# STORAGE_SIGNING_SECRET=replace-with-output-of-openssl-rand-base64-48
S3_ENDPOINT=http://localhost:9000
# Endpoint browsers use for presigned URLs when it differs from S3_ENDPOINT (Docker networking).
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Server-side encryption for PutObject (AES256 or aws:kms); leave unset for MinIO without KMS.
# S3_SSE=AES256
S3_REGION=us-east-1
S3_BUCKET=sentinel-photos
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
SIGNED_URL_TTL_SECONDS=300

# Anthropic (Claude) for photo analysis and report drafting (Phase 2+)
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_TEXT_MODEL=claude-opus-5-5

# Google OAuth for sign-in (Phase 1, optional) and Docs/Sheets/Drive export (Phase 3)
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
