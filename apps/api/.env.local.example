# Env used for the local (non-Docker) smoke test of the API. Placeholders only; copy what you
# need into your shell or a local .env and generate your own JWT_SECRET.
# Role passwords below match the defaults that `npm test -w @sentinel/api` sets on the local
# cluster (test/env.ts); change both together if you change them.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://sentinel_app:sentinel-app-local@localhost:5432/sentinel
MIGRATION_DATABASE_URL=postgres://sentinel_owner:sentinel-owner-local@localhost:5432/sentinel
# Generate with: openssl rand -base64 48 (placeholder values are rejected at startup)
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
LOG_LEVEL=info
# Leave as placeholders to keep Google sign-in disabled (404 google_not_configured).
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Phase 2: local photo storage and embedding (see the root .env.example for all options).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
API_PUBLIC_URL=http://localhost:3000
EMBED_ORIGINS=
# Leave as a placeholder to keep photo analysis off (503 ai_not_configured).
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
