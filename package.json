{
  "name": "sentinel-assess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @sentinel/api",
    "dev:web": "npm run dev -w @sentinel/web",
    "db:migrate": "npm run db:migrate -w @sentinel/api",
    "db:seed": "npm run db:seed -w @sentinel/api",
    "validate:frameworks": "npm run validate -w @sentinel/frameworks",
    "demo": "node scripts/demo/run-demo.mjs",
    "demo:reset": "node scripts/demo/run-demo.mjs --reset"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0"
  }
}
